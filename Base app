<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Safeword, maquette</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --serif:'Cormorant Garamond','Cormorant',Georgia,'Times New Roman',serif;
  --sans:'Jost','Avenir Next','Helvetica Neue',Arial,sans-serif;
  --bg:#F1EFEB; --surface:#FFFFFF; --ink:#0E0C09; --muted:#675F52;
  --gold:#8A6516; --gold-line:rgba(138,101,22,.42);
  --cta-bg:#0E0C09; --cta-ink:#F1DDA4; --cta-grad:#0E0C09;
  --brand-grad:linear-gradient(120deg,#6F4F0E 0%,#B88A2A 45%,#7A580F 100%);
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#000000; --surface:#15120D; --ink:#F3EBDD; --muted:#A39A8A;
    --gold:#D9B66B; --gold-line:rgba(217,182,107,.38);
    --cta-bg:#D9B66B; --cta-ink:#14100A;
    --cta-grad:linear-gradient(135deg,#B8903F 0%,#F1DDA4 48%,#C49A45 100%);
    --brand-grad:linear-gradient(120deg,#B8903F 0%,#F6E6B4 45%,#C49A45 100%);
  }
}
:root[data-theme="dark"]{
  --bg:#000000; --surface:#15120D; --ink:#F3EBDD; --muted:#A39A8A;
  --gold:#D9B66B; --gold-line:rgba(217,182,107,.38);
  --cta-bg:#D9B66B; --cta-ink:#14100A;
  --cta-grad:linear-gradient(135deg,#B8903F 0%,#F1DDA4 48%,#C49A45 100%);
  --brand-grad:linear-gradient(120deg,#B8903F 0%,#F6E6B4 45%,#C49A45 100%);
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

.app{height:100%;max-width:440px;margin:0 auto;display:flex;flex-direction:column;position:relative;overflow:hidden;background:var(--bg)}
@media (min-width:441px){.app{border-left:1px solid var(--gold-line);border-right:1px solid var(--gold-line)}}

.top{padding:14px 20px 8px;text-align:center;flex:none}
.top h1{margin-left:.14em}
.brand{font-family:var(--serif);font-weight:600;font-size:34px;line-height:1.05;margin:0;letter-spacing:.14em;color:var(--gold);background:var(--brand-grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;display:inline-block}
.rule{display:flex;align-items:center;gap:10px;justify-content:center;margin-top:8px;color:var(--gold)}
.rule i{display:block;height:1px;width:56px;background:var(--gold-line)}
.rule b{display:block;width:6px;height:6px;transform:rotate(45deg);border:1px solid var(--gold)}

main{flex:1;min-height:0;position:relative}
.view{position:absolute;inset:0;display:flex;flex-direction:column;min-height:0}
.view[hidden]{display:none}

/* Découvrir */
.deck{flex:1;position:relative;margin:6px 18px 0;min-height:0}
.card{position:absolute;inset:0;background:var(--surface);border:1px solid var(--gold);border-radius:8px;overflow:hidden;touch-action:pan-y;cursor:grab;box-shadow:0 22px 40px -24px rgba(0,0,0,.55);will-change:transform;user-select:none;-webkit-user-select:none}
.card::after{content:"";position:absolute;inset:6px;border:1px solid var(--gold-line);border-radius:4px;pointer-events:none}
.card.behind{transform:scale(.95) translateY(12px);opacity:.65;pointer-events:none}
.card-in{height:100%;overflow-y:auto;padding:24px 24px 20px}
.who{display:flex;gap:16px;align-items:center}
.who h2{font-family:var(--serif);font-weight:600;font-size:34px;line-height:1;margin:0}
.meta{margin:6px 0 0;color:var(--muted);font-size:14px;display:flex;flex-wrap:wrap;gap:4px 12px;align-items:center}
.ver{display:inline-flex;align-items:center;gap:4px;color:var(--gold)}
.ver svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2}
.seal{display:inline-block;margin:18px 0 0;padding:3px 16px 4px;border:1px solid var(--gold);color:var(--gold);font-family:var(--serif);font-style:italic;font-weight:600;font-size:19px;border-radius:2px}
blockquote{margin:16px 0 0;font-family:var(--serif);font-style:italic;font-weight:500;font-size:25px;line-height:1.25}
dl{margin:20px 0 0;padding-top:6px;border-top:1px solid var(--gold-line)}
dl>div{padding:12px 0;border-bottom:1px solid var(--gold-line)}
dt{font-family:var(--serif);font-style:italic;font-weight:600;font-size:18px;color:var(--gold);margin-bottom:5px}
dd{margin:0;line-height:1.45}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{padding:3px 10px;border:1px solid var(--gold-line);border-radius:999px;font-size:13px}
.tags.lim span{border-style:dashed;color:var(--muted)}
.hint{margin:14px 0 0;font-size:13px;color:var(--muted);display:flex;gap:8px;align-items:center}
.hint svg{width:15px;height:15px;flex:none;fill:none;stroke:var(--gold);stroke-width:1.6}

.stamp{position:absolute;top:22px;z-index:2;padding:2px 14px;border:2px solid;font-family:var(--serif);font-weight:600;font-size:26px;opacity:0;pointer-events:none;background:var(--surface)}
.stamp.yes{right:20px;color:var(--gold);transform:rotate(8deg)}
.stamp.no{left:20px;color:var(--muted);transform:rotate(-8deg)}

.actions{flex:none;display:flex;gap:12px;justify-content:center;padding:14px 18px 14px}
.actions[hidden]{display:none}
.btn{border:1px solid var(--cta-bg);background:var(--cta-grad,var(--cta-bg));color:var(--cta-ink);padding:12px 26px;border-radius:999px;font-weight:500;font-size:15px}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--gold-line)}
.btn.wide{flex:1;max-width:190px}
.empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px;gap:12px}
.empty h2{font-family:var(--serif);font-weight:600;font-size:30px;margin:0;line-height:1.1}
.empty p{margin:0 0 8px;color:var(--muted)}

/* Portrait flou */
.portrait{position:relative;flex:none;width:var(--s,64px);height:var(--s,64px);border-radius:50%;overflow:hidden;border:1px solid var(--gold);display:inline-block}
.pi{position:absolute;inset:-12%;background:radial-gradient(circle at 36% 30%,hsl(var(--h) 30% 60%),hsl(calc(var(--h) + 28) 34% 26%) 58%,hsl(calc(var(--h) + 60) 30% 9%));filter:blur(9px)}
.clear .pi{filter:none;inset:0}
.pl{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff}
.pl svg{width:42%;height:42%;fill:none;stroke:currentColor;stroke-width:1.6;filter:drop-shadow(0 1px 2px rgba(0,0,0,.5))}

/* Recherche */
.search{overflow-y:auto;padding:6px 20px 20px}
.search h2,.chat-title{font-family:var(--serif);font-weight:600;font-size:28px;margin:6px 0 4px}
.group{padding:12px 0;border-bottom:1px solid var(--gold-line)}
.group>span{display:block;font-family:var(--serif);font-style:italic;font-weight:600;font-size:18px;color:var(--gold);margin-bottom:8px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--gold-line);background:transparent;padding:8px 14px;border-radius:999px;font-size:14px}
.chip[aria-pressed="true"]{background:var(--cta-bg);color:var(--cta-ink);border-color:var(--cta-bg)}
input[type=range]{width:100%;accent-color:var(--gold)}
.rowline{display:flex;justify-content:space-between;align-items:center;gap:12px}
.sw{width:48px;height:28px;border-radius:999px;border:1px solid var(--gold-line);background:transparent;position:relative;padding:0;flex:none}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:var(--muted);transition:transform .2s,background .2s}
.sw[aria-checked="true"]{background:var(--cta-bg);border-color:var(--cta-bg)}
.sw[aria-checked="true"]::after{transform:translateX(20px);background:var(--cta-ink)}
.count{font-family:var(--serif);font-style:italic;font-size:19px;color:var(--muted);margin:16px 0 4px}
.result{display:flex;gap:14px;align-items:center;padding:12px 0;border-bottom:1px solid var(--gold-line)}
.result .info{flex:1;min-width:0}
.result b{font-family:var(--serif);font-weight:600;font-size:22px;display:block;line-height:1.1}
.result small{color:var(--muted);font-size:13px;display:block;margin-top:3px}
.result .btn{padding:8px 16px;font-size:14px}
.result .btn[disabled]{background:transparent;color:var(--muted);border-color:var(--gold-line)}
.none{color:var(--muted);padding:18px 0;line-height:1.5}

/* Messages */
.chat-head{display:flex;gap:14px;align-items:center;padding:4px 20px 10px;border-bottom:1px solid var(--gold-line)}
.chat-head b{font-family:var(--serif);font-weight:600;font-size:24px;display:block;line-height:1.1}
.chat-head small{color:var(--muted)}
.notice{margin:12px 20px 0;padding:10px 12px;border:1px solid var(--gold-line);border-radius:6px;font-size:13px;color:var(--muted);display:flex;gap:10px;align-items:flex-start;line-height:1.4}
.notice svg{width:16px;height:16px;flex:none;margin-top:1px;fill:none;stroke:var(--gold);stroke-width:1.6}
.chat{flex:1;min-height:0;overflow-y:auto;padding:14px 20px;display:flex;flex-direction:column;gap:10px}
.b{max-width:80%;padding:10px 14px;border-radius:14px;line-height:1.4}
.b.in{align-self:flex-start;background:var(--surface);border:1px solid var(--gold-line);border-bottom-left-radius:4px}
.b.out{align-self:flex-end;background:var(--cta-bg);color:var(--cta-ink);border-bottom-right-radius:4px}
.photo{align-self:flex-start;max-width:86%;background:var(--surface);border:1px solid var(--gold);border-radius:8px;padding:12px}
.thumb{position:relative;height:130px;border-radius:4px;overflow:hidden;border:1px solid var(--gold-line)}
.thumb .pl svg{width:30px;height:30px}
.photo p{margin:10px 0;font-size:14px;line-height:1.4}
.photo .row{display:flex;gap:8px}
.photo .btn{padding:9px 18px;font-size:14px;flex:1}
.link{background:none;border:0;padding:0;color:var(--gold);text-decoration:underline;font-size:13px}
.muted{color:var(--muted)}
.composer{flex:none;display:flex;gap:8px;padding:10px 14px;border-top:1px solid var(--gold-line);align-items:center}
.composer input{flex:1;min-width:0;border:1px solid var(--gold-line);background:var(--surface);color:var(--ink);padding:11px 16px;border-radius:999px;font:inherit}
.ib{width:42px;height:42px;border-radius:50%;border:1px solid var(--gold-line);background:transparent;display:flex;align-items:center;justify-content:center;flex:none;padding:0}
.ib svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6}
.ib.go{background:var(--cta-grad,var(--cta-bg));border-color:var(--cta-bg);color:var(--cta-ink)}

/* Navigation */
.tabs{flex:none;display:flex;border-top:1px solid var(--gold-line);background:var(--bg)}
.tab{flex:1;background:none;border:0;padding:10px 0 12px;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:4px;font-size:12px;font-weight:500}
.tab svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.5}
.tab[aria-selected="true"]{color:var(--gold)}

/* Superpositions */
.overlay{position:absolute;inset:0;background:rgba(10,2,5,.72);display:flex;align-items:center;justify-content:center;padding:24px;z-index:20}
.overlay[hidden]{display:none}
.modal{background:var(--surface);border:1px solid var(--gold);border-radius:8px;padding:30px 24px 24px;text-align:center;max-width:340px;width:100%}
.pair{display:flex;justify-content:center;margin-bottom:18px}
.pair .portrait+.portrait{margin-left:-14px}
.modal h2{font-family:var(--serif);font-weight:600;font-size:30px;line-height:1.1;margin:0 0 10px}
.modal p{margin:0 0 20px;color:var(--muted);line-height:1.5}
.modal .row{display:flex;gap:10px;justify-content:center}
.toast{position:absolute;left:50%;bottom:86px;transform:translate(-50%,10px);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:999px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:30;max-width:90%;text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}

@media (max-height:640px){
  blockquote{font-size:21px}
  .who h2{font-size:28px}
}
@media (prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
}

.kbd{display:none}
.kbd[hidden]{display:none!important}

@media (hover:hover){
  .btn:hover{filter:brightness(1.1)}
  .chip:hover{border-color:var(--gold)}
  .tab:hover{color:var(--ink)}
  .ib:hover{border-color:var(--gold)}
}

/* Version ordinateur */
@media (min-width:900px){
  .app{max-width:1240px;display:grid;grid-template-columns:270px 1fr;grid-template-rows:auto 1fr}
  .top{grid-column:1;grid-row:1;padding:44px 24px 28px;text-align:left}
  .top h1{margin-left:0;font-size:38px}
  .rule{justify-content:flex-start}
  main{grid-column:2;grid-row:1 / span 2;min-height:0;border-left:1px solid var(--gold-line)}
  .tabs{grid-column:1;grid-row:2;align-self:start;flex-direction:column;border-top:0;padding:0 16px;gap:4px}
  .tab{flex:none;flex-direction:row;justify-content:flex-start;gap:14px;padding:14px 18px;font-size:16px;border-radius:6px}
  .tab svg{width:22px;height:22px}
  .tab[aria-selected="true"]{background:var(--surface);box-shadow:inset 2px 0 0 var(--gold)}

  .deck{flex:1;max-width:540px;width:100%;margin:28px auto 0}
  .card-in{padding:36px 38px 30px}
  .who h2{font-size:42px}
  .seal{font-size:21px}
  blockquote{font-size:30px}
  .actions{padding:22px 18px 10px}
  .kbd{display:block;text-align:center;color:var(--muted);font-size:13px;padding:0 18px 22px}

  .search{width:100%;max-width:1060px;margin:0 auto;padding:36px 48px 40px}
  .search h2{font-size:40px;margin:0 0 14px}
  .cols{display:grid;grid-template-columns:320px 1fr;gap:56px;align-items:start}
  .res .count{margin-top:12px}
  #results{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));column-gap:32px}
  #results .none{grid-column:1 / -1}

  #v-messages{left:50%;right:auto;width:min(860px,100%);transform:translateX(-50%);border-left:1px solid var(--gold-line);border-right:1px solid var(--gold-line)}
  .chat-head{padding-top:28px}
  .b{max-width:68%}

  .toast{bottom:40px}
}
</style>
</head>
<body>
<div class="app">
  <header class="top">
    <h1 class="brand">Safeword</h1>
    <div class="rule" aria-hidden="true"><i></i><b></b><i></i></div>
  </header>

  <main>
    <section class="view" id="v-discover" aria-label="Découvrir">
      <div class="deck" id="deck"></div>
      <div class="actions" id="actions">
        <button class="btn ghost wide" id="btn-pass">Passer</button>
        <button class="btn wide" id="btn-yes">Inviter</button>
      </div>
      <p class="kbd" id="kbd">Astuce : utilisez les flèches ← et → de votre clavier.</p>
    </section>
    <section class="view" id="v-search" aria-label="Recherche" hidden></section>
    <section class="view" id="v-messages" aria-label="Messages" hidden></section>
  </main>

  <nav class="tabs" role="tablist" aria-label="Navigation">
    <button class="tab" role="tab" data-tab="discover" aria-selected="true">
      <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M8 2.5h8"/><path d="M9 11l2 2 4-4"/></svg>
      Découvrir
    </button>
    <button class="tab" role="tab" data-tab="search" aria-selected="false">
      <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/></svg>
      Recherche
    </button>
    <button class="tab" role="tab" data-tab="messages" aria-selected="false">
      <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg>
      Messages
    </button>
  </nav>

  <div class="overlay" id="overlay" hidden role="dialog" aria-modal="true"></div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</div>

<script>
const LOCK='<svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
const CHECK='<svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

const REL={unique:'Relation unique',multiple:'Plusieurs partenaires',sessions:'Sessions ponctuelles'};
const ROLES=['Dominant','soumise','Switch'];

const P=[
 {n:'Marc-Antoine',a:41,c:'Besançon',d:12,r:'Dominant',h:350,v:true,f:false,m:true,
  q:'Le contrôle commence par l’écoute.',
  seek:'Une relation suivie avec une seule partenaire.',
  dyn:['Protocole','Rituels du soir','Discipline douce'],
  lim:['Aucune marque visible','Pas d’humiliation en public'],rel:['unique']},
 {n:'Élise',a:34,c:'Dijon',d:95,r:'soumise',h:20,v:true,f:true,m:false,
  q:'Je cherche quelqu’un dont la parole tient.',
  seek:'Un Dominant patient, qui prend le temps de se découvrir.',
  dyn:['Service','Rituels','Communication franche'],
  lim:['Première rencontre en public','Aucune photo sans accord'],rel:['unique','sessions']},
 {n:'Victor',a:47,c:'Belfort',d:38,r:'Switch',h:290,v:false,f:false,m:false,
  q:'Selon l’humeur, selon la personne.',
  seek:'Plusieurs partenaires, dans une dynamique ouverte et franche.',
  dyn:['Découverte','Soirées privées','Ateliers'],
  lim:['Pas d’alcool pendant les séances'],rel:['multiple','sessions']},
 {n:'Camille',a:29,c:'Lyon',d:190,r:'soumise',h:330,v:true,f:true,m:true,
  q:'Douce en apparence, très attentive au reste.',
  seek:'Un duo ou une relation unique, avec des règles claires.',
  dyn:['Obéissance','Écriture et journal','Rituels du matin'],
  lim:['Rien sans mot de sécurité','Pas de contact en journée'],rel:['unique','multiple']},
 {n:'Sébastien',a:52,c:'Vesoul',d:55,r:'Dominant',h:30,v:true,f:false,m:false,
  q:'L’exigence est une forme d’attention.',
  seek:'Une soumise curieuse, pour une dynamique construite sur la durée.',
  dyn:['Protocole strict','Éducation','Cérémonie'],
  lim:['Pas de jeux dangereux','Discrétion absolue'],rel:['unique','sessions']}
];

const $=s=>document.querySelector(s);
const $$=s=>[...document.querySelectorAll(s)];

function portrait(p,size,clear){
  return `<span class="portrait${clear?' clear':''}" style="--h:${p.h};--s:${size}px"><span class="pi"></span>${clear?'':'<span class="pl">'+LOCK+'</span>'}</span>`;
}

/* Toast */
let toastT;
function toast(msg){
  const t=$('#toast');t.textContent=msg;t.classList.add('on');
  clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('on'),2600);
}

/* Navigation */
let tab='discover';
function show(t){
  tab=t;
  ['discover','search','messages'].forEach(k=>{$('#v-'+k).hidden=(k!==t)});
  $$('.tab').forEach(b=>b.setAttribute('aria-selected',b.dataset.tab===t));
  if(t==='messages'){const c=$('#chat');if(c)c.scrollTop=c.scrollHeight}
}
$$('.tab').forEach(b=>b.addEventListener('click',()=>show(b.dataset.tab)));

/* Découvrir */
let idx=0,busy=false;

function card(p){
  return `<article class="card">
    <div class="stamp yes">Inviter</div><div class="stamp no">Passer</div>
    <div class="card-in">
      <div class="who">${portrait(p,72)}
        <div><h2>${p.n}</h2>
          <p class="meta"><span>${p.a} ans, ${p.c}</span>${p.v?`<span class="ver">${CHECK}Vérifié${p.f?'e':''}</span>`:''}</p>
        </div>
      </div>
      <span class="seal">${p.r}</span>
      <blockquote>${p.q}</blockquote>
      <dl>
        <div><dt>Cherche</dt><dd>${p.seek}</dd></div>
        <div><dt>Dynamique</dt><dd class="tags">${p.dyn.map(x=>`<span>${x}</span>`).join('')}</dd></div>
        <div><dt>Limites</dt><dd class="tags lim">${p.lim.map(x=>`<span>${x}</span>`).join('')}</dd></div>
      </dl>
      <p class="hint">${LOCK}Le portrait se révèle après un accord mutuel.</p>
    </div>
  </article>`;
}

function renderDeck(){
  const deck=$('#deck'),acts=$('#actions');
  if(idx>=P.length){
    deck.innerHTML=`<div class="empty"><h2>Vous avez tout vu pour l’instant.</h2><p>Élargissez votre recherche ou revenez plus tard.</p><button class="btn" id="again">Revoir les profils</button></div>`;
    acts.hidden=true;$('#kbd').hidden=true;
    $('#again').onclick=()=>{idx=0;renderDeck()};
    return;
  }
  acts.hidden=false;$('#kbd').hidden=false;
  const next=P[idx+1];
  deck.innerHTML=(next?card(next).replace('class="card"','class="card behind"'):'')+card(P[idx]);
  attachDrag(deck.lastElementChild);
}

function setPos(c,dx){
  c.style.transform=`translateX(${dx}px) rotate(${dx/18}deg)`;
  const y=c.querySelector('.stamp.yes'),n=c.querySelector('.stamp.no');
  y.style.opacity=Math.max(0,Math.min(1,dx/100));
  n.style.opacity=Math.max(0,Math.min(1,-dx/100));
}

function attachDrag(c){
  let sx=0,dx=0,drag=false;
  c.addEventListener('pointerdown',e=>{
    if(busy)return;drag=true;sx=e.clientX;dx=0;
    c.setPointerCapture(e.pointerId);c.style.transition='none';c.style.cursor='grabbing';
  });
  c.addEventListener('pointermove',e=>{
    if(!drag)return;dx=e.clientX-sx;setPos(c,dx);
  });
  const end=()=>{
    if(!drag)return;drag=false;c.style.cursor='';
    c.style.transition='transform .25s ease';
    if(Math.abs(dx)>110){decide(dx>0?'yes':'no')}
    else{setPos(c,0)}
  };
  c.addEventListener('pointerup',end);
  c.addEventListener('pointercancel',end);
}

function decide(dir){
  if(busy||idx>=P.length)return;
  busy=true;
  const c=$('#deck .card:not(.behind)');
  const p=P[idx];
  const x=dir==='yes'?520:-520;
  c.style.transition='transform .35s ease, opacity .35s ease';
  c.style.transform=`translateX(${x}px) rotate(${x/18}deg)`;
  c.style.opacity='0';
  setTimeout(()=>{
    idx++;busy=false;renderDeck();
    if(dir==='yes'){
      if(p.m)showMatch(p);
      else toast('Invitation envoyée à '+p.n+'.');
    }
  },330);
}

$('#btn-yes').addEventListener('click',()=>decide('yes'));
$('#btn-pass').addEventListener('click',()=>decide('no'));
document.addEventListener('keydown',e=>{
  if(tab!=='discover'||!$('#overlay').hidden)return;
  if(e.key==='ArrowRight')decide('yes');
  if(e.key==='ArrowLeft')decide('no');
});

function showMatch(p){
  const o=$('#overlay');
  o.hidden=false;
  o.innerHTML=`<div class="modal">
    <div class="pair">${portrait({h:200},84,true)}${portrait(p,84,true)}</div>
    <h2>Accord mutuel avec ${p.n}</h2>
    <p>Vos portraits sont désormais visibles. Les photos envoyées en message restent soumises à l’accord de la destinataire.</p>
    <div class="row"><button class="btn ghost" id="m-go">Continuer</button><button class="btn" id="m-write">Écrire</button></div>
  </div>`;
  $('#m-go').onclick=()=>{o.hidden=true};
  $('#m-write').onclick=()=>{o.hidden=true;show('messages')};
  $('#m-write').focus();
}

/* Recherche */
const F={roles:new Set(),rel:new Set(),dist:200,verified:false};
const sent=new Set();

function renderSearch(){
  const v=$('#v-search');
  v.innerHTML=`<div class="search">
    <h2>Recherche</h2>
    <div class="cols"><div class="filters">
    <div class="group"><span>Rôle</span><div class="chips">${ROLES.map(r=>`<button class="chip" data-k="roles" data-v="${r}" aria-pressed="false">${r}</button>`).join('')}</div></div>
    <div class="group"><span>Relation recherchée</span><div class="chips">${Object.entries(REL).map(([k,l])=>`<button class="chip" data-k="rel" data-v="${k}" aria-pressed="false">${l}</button>`).join('')}</div></div>
    <div class="group"><span>Distance</span>
      <input type="range" id="dist" min="10" max="200" step="10" value="200" aria-label="Distance maximale">
      <div class="muted" id="dist-l">Jusqu’à 200 km</div></div>
    <div class="group"><div class="rowline"><div><span style="margin:0">Profils vérifiés</span><div class="muted" style="font-size:13px;margin-top:2px">Identité confirmée par l’équipe</div></div>
      <button class="sw" id="ver" role="switch" aria-checked="false" aria-label="Profils vérifiés seulement"></button></div></div>
    </div>
    <div class="res"><div class="count" id="count"></div>
    <div id="results"></div></div></div>
  </div>`;
  $$('#v-search .chip').forEach(b=>b.addEventListener('click',()=>{
    const set=F[b.dataset.k],val=b.dataset.v;
    if(set.has(val)){set.delete(val);b.setAttribute('aria-pressed','false')}
    else{set.add(val);b.setAttribute('aria-pressed','true')}
    updateResults();
  }));
  $('#dist').addEventListener('input',e=>{F.dist=+e.target.value;$('#dist-l').textContent='Jusqu’à '+F.dist+' km';updateResults()});
  $('#ver').addEventListener('click',e=>{
    F.verified=!F.verified;e.currentTarget.setAttribute('aria-checked',F.verified);updateResults();
  });
  updateResults();
}

function updateResults(){
  const list=P.filter(p=>
    (!F.roles.size||F.roles.has(p.r))&&
    (!F.rel.size||p.rel.some(x=>F.rel.has(x)))&&
    p.d<=F.dist&&(!F.verified||p.v)
  ).sort((a,b)=>a.d-b.d);
  $('#count').textContent=list.length+(list.length>1?' profils':' profil');
  $('#results').innerHTML=list.length?list.map(p=>`
    <div class="result">${portrait(p,52)}
      <div class="info"><b>${p.n}, ${p.a}</b><small>${p.r}, ${p.c}, à ${p.d} km${p.v?', vérifié'+(p.f?'e':''):''}</small></div>
      <button class="btn" data-n="${p.n}" ${sent.has(p.n)?'disabled':''}>${sent.has(p.n)?'Envoyée':'Inviter'}</button>
    </div>`).join('')
    :`<p class="none">Aucun profil ne correspond. Élargissez la distance ou retirez un filtre.</p>`;
  $$('#results .btn').forEach(b=>b.addEventListener('click',()=>{
    sent.add(b.dataset.n);b.disabled=true;b.textContent='Envoyée';
    toast('Invitation envoyée à '+b.dataset.n+'.');
  }));
}

/* Messages */
let photo='pending';
const msgs=[
  {w:'in',t:'Bonsoir Élise. Merci d’avoir accepté l’invitation.'},
  {w:'out',t:'Bonsoir. J’ai lu votre profil avec attention.'},
  {w:'in',t:'Je préfère qu’on se connaisse un peu avant. Puis-je vous envoyer une photo ?'}
];
const HOST=P[0];

function photoBlock(){
  if(photo==='pending')return `<div class="photo">
    <div class="thumb"><span class="pi" style="--h:${HOST.h}"></span><span class="pl">${LOCK}</span></div>
    <p>${HOST.n} souhaite vous envoyer une photo. Elle reste floutée tant que vous n’avez pas accepté.</p>
    <div class="row"><button class="btn ghost" data-a="refuse">Refuser</button><button class="btn" data-a="accept">Accepter</button></div></div>`;
  if(photo==='accepted')return `<div class="photo">
    <div class="thumb clear"><span class="pi" style="--h:${HOST.h};filter:none;inset:0"></span></div>
    <p>Photo reçue avec votre accord.</p>
    <button class="link" data-a="block">Bloquer ce contact</button></div>`;
  if(photo==='blocked')return `<div class="photo"><p class="muted" style="margin:0">Contact bloqué. Plus aucun message ni photo ne vous parviendra.</p></div>`;
  return `<div class="photo"><p class="muted" style="margin:0">Photo refusée et supprimée.</p></div>`;
}

function renderMessages(keepDraft){
  const v=$('#v-messages');
  const draft=keepDraft&&$('#msg')?$('#msg').value:'';
  v.innerHTML=`
    <div class="chat-head">${portrait(HOST,52,true)}<div><b>${HOST.n}</b><small>Dominant, accord mutuel</small></div></div>
    <div class="notice">${LOCK}<span>Aucune photo n’arrive sans votre accord. Elles restent floutées tant que vous n’avez pas choisi.</span></div>
    <div class="chat" id="chat">
      ${msgs.map(m=>`<div class="b ${m.w}">${m.t}</div>`).join('')}
      ${photoBlock()}
    </div>
    <div class="composer">
      <button class="ib" id="ph" aria-label="Demander l’envoi d’une photo">
        <svg viewBox="0 0 24 24"><rect x="3.5" y="6" width="17" height="13" rx="2"/><circle cx="12" cy="12.5" r="3.2"/><path d="M8.5 6l1.2-2h4.6l1.2 2"/></svg>
      </button>
      <input id="msg" type="text" placeholder="Écrire un message" aria-label="Message" value="${draft.replace(/"/g,'&quot;')}">
      <button class="ib go" id="send" aria-label="Envoyer">
        <svg viewBox="0 0 24 24"><path d="M4 12l16-8-6 16-3-7z"/></svg>
      </button>
    </div>`;
  const c=$('#chat');c.scrollTop=c.scrollHeight;
  $$('#chat [data-a]').forEach(b=>b.addEventListener('click',()=>{
    const a=b.dataset.a;
    if(a==='accept')photo='accepted';
    if(a==='refuse')photo='refused';
    if(a==='block'){photo='blocked';toast('Contact bloqué.')}
    renderMessages(true);
  }));
  $('#ph').onclick=()=>toast('Une demande d’accord est envoyée à la destinataire avant toute photo.');
  const send=()=>{
    const i=$('#msg'),t=i.value.trim();
    if(!t)return;
    msgs.push({w:'out',t:t.replace(/[<>&]/g,ch=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[ch]))});
    renderMessages(false);$('#msg').focus();
  };
  $('#send').onclick=send;
  $('#msg').addEventListener('keydown',e=>{if(e.key==='Enter')send()});
}

renderDeck();
renderSearch();
renderMessages(false);
</script>
</body>
</html>
